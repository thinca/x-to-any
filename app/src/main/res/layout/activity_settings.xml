<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:id="@+id/link_settings_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/link_settings_heading"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <TextView
                android:id="@+id/link_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:text="@string/link_settings_description" />

            <Button
                android:id="@+id/open_x_link_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:text="@string/open_x_link_settings" />

            <Button
                android:id="@+id/open_own_link_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_own_link_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/targets_heading"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <EditText
            android:id="@+id/target_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/target_filter_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <RadioGroup
            android:id="@+id/targets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
